# Salin file ini menjadi ".env" (setup.bat melakukannya otomatis), lalu ubah seperlunya.
# Baris yang diawali tanda # diabaikan. Setelah mengubah .env, jalankan ulang run.bat.

# Nama aplikasi dan nama kantor di pojok kiri atas
APP_NAME=SuratKu
ORG_NAME=

# Lokasi LibreOffice (untuk membuat PDF). Biarkan kosong agar dicari otomatis.
# Contoh: SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=

# Apakah nomor surat yang dibatalkan boleh dipakai lagi? true = boleh, false = tidak boleh
ALLOW_REUSE_VOID=true

# Lama login (jam) sebelum diminta masuk lagi
SESSION_HOURS=10
